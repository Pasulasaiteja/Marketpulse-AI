{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relative change, e.g. 0.2 = +20%.",
          "title": "Magnitude"
        },
        "observed": {
          "default": true,
          "description": "True if measured in data; False if inferred.",
          "title": "Observed",
          "type": "boolean"
        },
        "predictive_value_established": {
          "default": false,
          "description": "True only if an ablation showed this signal lowers forecast error. Unvalidated signals must not move forecasts.",
          "title": "Predictive Value Established",
          "type": "boolean"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "signal_id": {
          "title": "Signal Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "demand_shift",
            "unmet_demand",
            "category_growth",
            "price_change",
            "review_theme",
            "seasonality"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "type",
        "direction",
        "confidence"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date",
      "title": "Generated At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "title": "Signals",
      "type": "array"
    }
  },
  "required": [
    "generated_at"
  ],
  "title": "SignalOutput",
  "type": "object"
}
